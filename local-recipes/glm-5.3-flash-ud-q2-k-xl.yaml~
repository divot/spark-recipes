# GLM-5.3-Flash / Unsloth UD-Q2_K_XL on ONE DGX Spark.
#
# Place this file at:
#   local-recipes/glm-5.3-flash-ud-q2-k-xl.yaml
#
# ONE-TIME IMAGE BUILD
# --------------------
# From the root of eugr/spark-vllm-docker:
#
#   docker build \
#     -f local-recipes/Dockerfile.glm53-llamacpp \
#     -t glm53-llamacpp:cuda13.0 \
#     local-recipes
#
# RUN
# ---
#   ./run-recipe.sh local-recipes/glm-5.3-flash-ud-q2-k-xl.yaml --solo
#
# First launch downloads only the selected UD-Q2_K_XL GGUF (~109 GB, 4 shards)
# through llama.cpp's -hf support.  spark-vllm-docker already mounts the host
# Hugging Face cache at /root/.cache/huggingface, so the download survives
# container recreation.
#
# IMPORTANT:
#   * Do NOT use --setup or --build-only for this local recipe.  Build the
#     custom image with the docker command above.  The repo's current recipe
#     build path delegates to build-and-copy.sh, which is vLLM-image oriented.
#   * Do NOT add --no-mmap on the Spark's unified-memory system.
#   * 256K + q8_0 KV + native MTP is a measured single-Spark configuration.
#   * Do NOT try 1M context on one Spark.  Published tests have hard-wedged
#     the machine under memory pressure.
#   * For a lighter first smoke test:
#       ./run-recipe.sh local-recipes/glm-5.3-flash-ud-q2-k-xl.yaml \
#         --solo --max-model-len 32768
#
# GLM-5.3-Flash's chat template accepts request-level:
#   "chat_template_kwargs": {"reasoning_effort": "low"|"high"|"max"}
# Unspecified reasoning effort resolves to max.

recipe_version: "1"
name: GLM-5.3-Flash-UD-Q2_K_XL
description: >-
  Single-DGX-Spark GLM-5.3-Flash using Unsloth UD-Q2_K_XL GGUF,
  llama.cpp glm5next MTP branch, q8 KV cache, and native MTP speculative decode.

container: glm53-llamacpp:cuda13.0
solo_only: true

env:
  HF_HOME: /root/.cache/huggingface

defaults:
  host: 0.0.0.0
  port: 8000
  max_model_len: 262144
  parallel: 1
  cache_ram_mib: 512

command: |
  llama-server \
    -hf unsloth/GLM-5.3-Flash-GGUF:UD-Q2_K_XL \
    --host {host} \
    --port {port} \
    --n-gpu-layers 999 \
    --ctx-size {max_model_len} \
    --parallel {parallel} \
    --cache-type-k q8_0 \
    --cache-type-v q8_0 \
    --flash-attn on \
    --cache-ram {cache_ram_mib} \
    --jinja \
    --spec-type draft-mtp
